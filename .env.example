# Curato backend configuration.
#
# Copy to `.env` and adjust. `.env` is gitignored; this template is what gets committed,
# so every value here is a safe placeholder and never a real secret.
#
#   cp .env.example .env && docker compose up

# ---- Service ----
PORT=8080
# Comma-separated allowlist. Never `*` — the service refuses to start with a wildcard.
CORS_ORIGINS=http://localhost:8080
# Request body cap, in bytes. Larger requests are rejected before parsing.
MAX_REQUEST_BODY_BYTES=16384
# debug | info | warn | error | silent
LOG_LEVEL=info

# ---- Upstream catalogue (Fake Store) ----
UPSTREAM_BASE_URL=https://fakestoreapi.com
UPSTREAM_TIMEOUT_MS=5000
# Additional attempts after the first, so a hung upstream degrades us rather than
# exhausting our connections.
UPSTREAM_RETRIES=2

# ---- Catalogue cache ----
# How long a fetched catalogue is served without re-checking upstream.
CACHE_TTL_SECONDS=300
# How much further past the TTL stale data may still be served when upstream is
# unreachable. Degrading beats a dead catalogue, but only up to a point.
CACHE_MAX_STALE_SECONDS=3600

# ---- Home shelf ----
# Unset or blank  -> the computed top 5 by rating, headed "Top rated".
# Set (e.g. 1,4,9) -> those ids in that order, headed "Featured".
# A curated list is not a ranking, which is why the heading changes with it. Ids that no
# longer resolve are skipped and logged; a list where none resolve falls back to
# computed, so this can never empty the home page.
FEATURED_PRODUCT_IDS=

# ---- Email ----
# Mailhog locally. Under docker compose this is overridden to the `mailhog` service.
SMTP_HOST=localhost
SMTP_PORT=1025
# Where enquiries are delivered. Required — the service will not start without it.
SALES_INBOX_ADDRESS=sales@curato.test
# The envelope sender. Required.
MAIL_FROM_ADDRESS=noreply@curato.test

# ---- Abuse control on POST /enquiries ----
# Unauthenticated and it causes email to be sent, so it is rate limited per client IP.
# Counts attempts, not successes.
ENQUIRY_RATE_LIMIT=5
ENQUIRY_RATE_WINDOW_S=600
