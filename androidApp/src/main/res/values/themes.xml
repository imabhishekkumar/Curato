<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The platform splash screen API, per SPEC.md §7.1 — no custom screen, no timed
      delay, no branding animation. It hands off the moment Home's first frame is ready.
    -->
    <style name="Theme.Curato.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/curato_catalogue_mark</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/curato_icon_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Curato</item>
    </style>

    <style name="Theme.Curato" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
